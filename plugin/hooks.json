{
  "agent-observability": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use.js",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.js",
        "timeout": 10
      }
    ]
  }
}
